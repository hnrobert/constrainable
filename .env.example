# ---- Runtime ----
HOST=0.0.0.0
PORT=31954
NODE_ENV=production
TZ=Asia/Shanghai

# ---- Database & storage ----
DB_PATH=./data/app.db
RECORD_DIR=./records

# ---- SRS endpoints (server-to-server; in docker these are container service names) ----
SRS_API_BASE=http://127.0.0.1:1985/api/v1
SRS_FLV_BASE=http://127.0.0.1:8080
SRS_RTMP_HOST=127.0.0.1
# Browser-facing SRS ports for viewer playback URLs (FLV / WHEP)
SRS_FLV_PORT=8080
SRS_API_PORT=1985

# ---- Browser-visible host for playback URLs (your LAN / public IP) ----
PUBLIC_HOST=127.0.0.1

# ---- Binaries ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Auth ----
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
# leave blank to auto-generate a random password on first boot (printed to logs)
ADMIN_PASSWORD=
# AES-256-GCM key for at-rest secrets (RTMP authmod verifier). Set in prod.
AUTHMOD_VERIFIER_SECRET=change-me-to-a-long-random-string
# Shared secret guarding internal RTMP-auth endpoints (app <-> RTMP gateway).
# MEDIA_NODE_AUTH_TOKEN=change-me-to-a-long-random-string
#
# Media node (media-node/) — the Go RTMP front-door. Set on the media-node
# container in docker-compose.media-node.yml (not the app):
#   NODE_ORIGIN=http://app:31954  Node control plane URL (socket.io + auth)
#   SELF_ORIGIN=localhost         this node's public identifier
#   RTMP_PORT=1935                RTMP ingest port (the only listener)
#   SRS_ADDR=srs-media:1935       dedicated SRS RTMP relay target
#   SRS_API_BASE=http://srs-media:1985/api/v1  SRS HTTP API for metrics
#   RECORD_DIR=/records           DVR recording storage (shared volume with SRS)
#   MEDIA_NODE_AUTH_TOKEN              must equal the app's MEDIA_NODE_AUTH_TOKEN above

# ---- Socket.IO fallback port (only used if the Nitro listen hook yields no server) ----
SOCKET_PORT=31954
