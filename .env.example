# ---- Runtime ----
HOST=0.0.0.0
PORT=31954
NODE_ENV=production
TZ=Asia/Shanghai

# ---- Database & storage ----
DB_PATH=./data/app.db
RECORD_DIR=./records

# ---- LOCAL SRS endpoints (dev fallback only; media-node sessions route to the
# node's advertised SRS_FLV_BASE automatically). SRS http_server port 38081;
# 38080 is the media-node play entry (not used by this backend). ----
SRS_API_BASE=http://127.0.0.1:1985/api/v1
SRS_FLV_BASE=http://127.0.0.1:38081
SRS_RTMP_HOST=127.0.0.1
# Browser-facing SRS API port (WHEP playback URLs)
SRS_API_PORT=1985

# ---- OBS ingest host override (optional) ----
# Default: derived at runtime from the origin users browse the app at
# (API_ORIGIN's host in split deployments). Set only for NAT/asymmetric setups.
# PUBLIC_HOST=203.0.113.10

# ---- Split deployment (static frontend on another origin, e.g. a CDN) ----
# Frontend side (baked at `bun run generate` time): absolute API origin for
# browser API calls + Socket.IO. Empty = same-origin (default).
# API_ORIGIN=https://api.example.com
# Backend side: frontend origins allowed to make credentialed cross-origin
# requests (comma-separated). Also switches the session cookie to
# SameSite=None; Secure — requires HTTPS on the API origin.
# CORS_ORIGINS=https://cdn.example.com

# ---- Binaries ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Auth ----
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
# leave blank to auto-generate a random password on first boot (printed to logs)
ADMIN_PASSWORD=
# AES-256-GCM key for at-rest secrets (RTMP authmod verifier). Set in prod.
AUTHMOD_VERIFIER_SECRET=change-me-to-a-long-random-string
# Shared secret guarding the app <-> media-node Socket.IO connection.
# Empty = no auth. Set the SAME value on the media-node container.
# MEDIA_NODE_AUTH_TOKEN=change-me-to-a-long-random-string

# ---- Socket.IO fallback port (only used if the Nitro listen hook yields no server) ----
SOCKET_PORT=31954
